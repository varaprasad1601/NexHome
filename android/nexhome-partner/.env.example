# Optional. While developing, the app finds the backend by itself: the computer running `npx expo start`, port 8080,
# so any phone or emulator on the same Wi-Fi works with no .env at all.
# Set this only to use a fixed server instead (copy this file to .env), e.g. a deployed backend or a release build:
# EXPO_PUBLIC_API_BASE_URL=http://192.168.29.230:8080
# Or keep the automatic address but another backend port:
# EXPO_PUBLIC_API_PORT=8080
