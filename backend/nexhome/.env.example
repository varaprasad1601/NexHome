DB_URL=jdbc:postgresql://localhost:5432/nexhome
DB_USERNAME=
DB_PASSWORD=
# Base64 of at least 32 random bytes, e.g. openssl rand -base64 48
JWT_SECRET=
# Optional, comma-separated; defaults to http://localhost:5173
#CORS_ALLOWED_ORIGINS=
# Base64 of exactly 32 random bytes (AES-256), e.g. openssl rand -base64 32. Encrypts Aadhaar, document and bank
# account numbers: changing it makes the stored values unreadable.
DATA_ENCRYPTION_KEY=
# Signs payment webhooks (HMAC-SHA256, header X-NexHome-Signature); dev defaults to nexhome-dev-webhook-secret
#PAYMENT_WEBHOOK_SECRET=
# SMS for OTPs: log (default: nothing is sent; dev logs the OTP) or msg91
#SMS_PROVIDER=msg91
# MSG91: the account's auth key, and the Flow template of the DLT-approved OTP message (its variable ##otp## takes
# the code; set MSG91_OTP_VARIABLE if the template names it differently)
#MSG91_AUTH_KEY=
#MSG91_OTP_TEMPLATE_ID=
#MSG91_OTP_VARIABLE=otp
# File storage: local (default: a folder on this machine, STORAGE_LOCAL_ROOT, default ~/nexhome-storage), r2 or s3.
# For r2 (Cloudflare R2): a private bucket (public access off) and an R2 API token with Object Read & Write on it only;
# the endpoint is the account's S3 API address, without the bucket.
#STORAGE_PROVIDER=r2
#R2_ENDPOINT=https://<account id>.r2.cloudflarestorage.com
#R2_BUCKET=nexhome-file-storage
#R2_ACCESS_KEY=
#R2_SECRET_KEY=
# For s3: a private bucket in Mumbai (Block all public access on, default encryption SSE-S3) and an IAM user that may
# only put, get and delete objects in it. With the keys empty, the AWS default credentials are used (e.g. the
# server's IAM role).
#STORAGE_PROVIDER=s3
#STORAGE_LOCAL_ROOT=
#S3_BUCKET=nexhome-files-prod
#S3_REGION=ap-south-1
#S3_ACCESS_KEY=
#S3_SECRET_KEY=
# Only for another S3-compatible store (MinIO, Cloudflare R2); empty for AWS
#S3_ENDPOINT=
# Push notifications to the customer and partner apps: log (default: nothing is pushed) or fcm. For fcm, the Firebase
# service account key: Firebase console > Project settings > Service accounts > Generate new private key. Keep the
# JSON outside the repository (or as firebase-service-account.json here, which git ignores).
#PUSH_PROVIDER=fcm
#FIREBASE_CREDENTIALS_FILE=C:/Users/<you>/nexhome-secrets/firebase-service-account.json
